# ClaimTrace backend configuration
# Local default: SQLite. Render production/pilot: set DATABASE_URL from Render Postgres.
DATABASE_URL=
CLAIMTRACE_DB_PATH=./data/claimtrace.sqlite3
CLAIMTRACE_MAX_UPLOAD_BYTES=26214400
CLAIMTRACE_AUTH_MODE=required
CLAIMTRACE_SESSION_HOURS=12
CLAIMTRACE_CORS_ORIGINS=http://localhost:5173
CLAIMTRACE_BOOTSTRAP_EMAIL=
CLAIMTRACE_BOOTSTRAP_PASSWORD=
CLAIMTRACE_BOOTSTRAP_TENANT_ID=TENANT-PILOT
CLAIMTRACE_BOOTSTRAP_TENANT_NAME=ClaimTrace Pilot
